{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velalab.net/schema/hotel-content-v1.json",
  "title": "Vela TV Hotel guest content v1",
  "type": "object",
  "required": ["schema_version", "hotel", "guest_welcome", "quick_apps", "resort", "explore", "guest"],
  "properties": {
    "schema_version": {"const": 1},
    "hotel": {
      "type": "object", "required": ["name"],
      "properties": {"name": {"const": "Ao Nang Fiore Resort"}}
    },
    "guest_welcome": {
      "type": "object", "required": ["mode", "value"],
      "properties": {"mode": {"const": "generic"}, "value": {"const": ""}}
    },
    "quick_apps": {"const": ["Netflix", "Disney+", "YouTube", "Prime Video", "iQIYI"]},
    "resort": {"$ref": "#/$defs/section"},
    "explore": {"$ref": "#/$defs/section"},
    "guest": {"$ref": "#/$defs/section"},
    "approved_content": {"type": "object"},
    "room_service": {"$ref": "#/$defs/roomService"}
  },
  "$defs": {
    "roomService": {
      "type": "object", "additionalProperties": false,
      "required": ["menuVersion", "currency", "contact", "categories"],
      "properties": {
        "menuVersion": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,48}$"},
        "currency": {"const": "THB"},
        "contact": {"type": "string", "pattern": "^[0-9]{1,12}$"},
        "categories": {"type": "array", "minItems": 1, "maxItems": 20,
          "items": {"$ref": "#/$defs/menuCategory"}}
      }
    },
    "menuCategory": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title_en", "items"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "title_en": {"type": "string", "minLength": 1, "maxLength": 80},
        "items": {"type": "array", "minItems": 1, "maxItems": 83,
          "items": {"$ref": "#/$defs/menuItem"}}
      }
    },
    "menuItem": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "name_th", "name_en", "price_thb"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 83},
        "name_th": {"type": "string", "minLength": 1, "maxLength": 160},
        "name_en": {"type": "string", "minLength": 1, "maxLength": 160},
        "price_thb": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "section": {
      "type": "object", "required": ["items"],
      "properties": {
        "items": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "verified"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "description": {"type": "string", "maxLength": 2000},
        "verified": {"type": "boolean"},
        "category": {"type": "string"}
      },
      "if": {"properties": {"verified": {"const": false}}},
      "then": {"properties": {"description": {"pattern": "TEST DATA"}}}
    }
  }
}
