{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velalab.net/schema/hotel-content-sync-manifest-v1.json",
  "title": "Vela TV Hotel content sync manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "publishedAt", "minAppVersionCode", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contentVersion": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "publishedAt": {"type": "string", "format": "date-time"},
    "minAppVersionCode": {"type": "integer", "minimum": 15},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "downloadPath", "sha256", "size"],
        "properties": {
          "kind": {"enum": ["content", "image", "video"]},
          "path": {"type": "string", "pattern": "^(content\\.json|media/[A-Za-z0-9_-]{1,64}\\.(jpg|jpeg|png|mp4))$"},
          "downloadPath": {"type": "string", "pattern": "^/api/v1/(device/content/[1-9][0-9]*/[0-9a-f]{64}\\.json|media/[0-9a-f]{64}\\.(jpg|jpeg|png|mp4))$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1, "maximum": 52428800},
          "durationSeconds": {"type": "integer", "minimum": 1, "maximum": 120}
        }
      }
    }
  }
}
