# Example only. Replace hostnames, cert paths and admin CIDR after pilot approval.
# Firewall: allow TCP/443 from hotel LAN only; never expose 8131 externally.
hotel-tv.example.com {
    tls C:/ProgramData/VelaTVHotel/tls/fullchain.pem C:/ProgramData/VelaTVHotel/tls/key.pem
    @tv path /healthz /api/v1/device/* /api/v1/media/*
    handle @tv {
        reverse_proxy 127.0.0.1:8131
    }
    handle {
        respond "Not found" 404
    }
}

hotel-admin.example.com {
    tls C:/ProgramData/VelaTVHotel/tls/admin-fullchain.pem C:/ProgramData/VelaTVHotel/tls/admin-key.pem
    @staff remote_ip 192.0.2.0/24
    handle @staff {
        reverse_proxy 127.0.0.1:8131
    }
    handle {
        respond "Forbidden" 403
    }
}
