# Development gateway only. Do not run before the readiness gates in
# docs/HTTPS-DEV-GATEWAY-PHASE-2C4.md are satisfied.
# Requires Caddy >= 2.10 for request_body max_size.
# Required environment: HOTEL_DEV_HOST, HOTEL_DEV_BIND_IP, HOTEL_DEV_CERT_PEM,
# HOTEL_DEV_KEY_PEM, HOTEL_DEV_ACCESS_LOG. No credential values belong here.
{
    admin off
    auto_https off
}

{$HOTEL_DEV_HOST} {
    bind {$HOTEL_DEV_BIND_IP}
    tls {$HOTEL_DEV_CERT_PEM} {$HOTEL_DEV_KEY_PEM}

    # Never log Authorization, Cookie, URL paths/queries or enrollment payloads.
    log {
        output file {$HOTEL_DEV_ACCESS_LOG} {
            roll_size 10MiB
            roll_keep 5
        }
        format filter {
            request>headers delete
            request>uri delete
        }
    }

    request_body {
        max_size 4KB
    }

    @admin path /admin /admin/* /api/v1/admin /api/v1/admin/*
    handle @admin {
        respond "Forbidden" 403
    }

    @health {
        method GET
        path /healthz
    }
    handle @health {
        reverse_proxy 127.0.0.1:8132
    }

    @enroll {
        method POST
        path /api/v1/device/enroll
    }
    handle @enroll {
        reverse_proxy 127.0.0.1:8132
    }

    @device_get {
        method GET
        path /api/v1/device/content-manifest /api/v1/device/content/* /api/v1/device/manifest /api/v1/media/*
    }
    handle @device_get {
        reverse_proxy 127.0.0.1:8132
    }

    handle {
        respond "Not found" 404
    }
}
